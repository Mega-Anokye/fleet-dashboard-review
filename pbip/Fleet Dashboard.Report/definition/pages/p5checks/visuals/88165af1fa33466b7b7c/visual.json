    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What was checked and what it means",
                    "textStyle": {
                      "fontSize": "22pt",
                      "color": "#1F2937",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Passed: every fuel and maintenance record has a unique ID; every fuel record's distance equals end odometer minus start odometer; preventive + corrective jobs add up to the total; driver trips (10,318) match the number of fuel records.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Small difference: recalculating fuel cost as litres × pump rate gives a total $393 lower than the recorded cost (about 0.02%). This looks like rounding in the pump rate and does not change any conclusion.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "To follow up: 56 coupon numbers each appear on two fills, on different trucks and different dates (listed on the Fuel page). In a real fleet this is worth checking with the fuel desk, as reused coupons can mean data-entry errors or misuse.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Coverage gaps: 4 of the 50 trucks have no driver record, so they appear in fuel and maintenance figures but not on the Drivers page. The driver table is one row per driver for the whole period with no dates, so the date filter cannot apply to it.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Method notes: driver rankings use rates per 100 trips because four drivers completed about twice as many trips as the rest, so raw counts would overstate their risk. Ratios return blank (not zero) when there is no data, so a truck with no fuel records is never ranked as 'least efficient'.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
