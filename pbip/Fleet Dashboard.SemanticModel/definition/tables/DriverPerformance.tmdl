	partition DriverPerformance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "driver_performance_actros_usd.csv"),[Delimiter=",", Columns=10, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Driver Name", type text}, {"Truck ID", type text}, {"Trips Completed", Int64.Type}, {"Total Hours Driven", type number}, {"Safety Score", Int64.Type}, {"Harsh Braking Events", Int64.Type}, {"Over-Speeding Events", Int64.Type}, {"Excessive Idling Mins", Int64.Type}, {"Late Deliveries", Int64.Type}, {"Fuel ECO Rating", type text}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"Driver Name", Text.Trim, type text}, {"Truck ID", Text.Trim, type text}, {"Fuel ECO Rating", Text.Trim, type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"Driver Name", Text.Clean, type text}, {"Truck ID", Text.Clean, type text}, {"Fuel ECO Rating", Text.Clean, type text}}),
				    #"Added Custom" = Table.AddColumn(#"Cleaned Text", "Fuel ECO Category", each Text.BeforeDelimiter(
				    Text.Trim([Fuel ECO Rating]),
				    " - "
				)),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Fuel ECO Category", type text}}),
				    #"Added Custom1" = Table.AddColumn(#"Changed Type1", "Fuel ECO Description", each Text.AfterDelimiter(
				    Text.Trim([Fuel ECO Rating]),
				    " - "
				)),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Excessive Idling Hours", each [Excessive Idling Mins] / 60),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Added Custom2",{{"Fuel ECO Description", type text}, {"Excessive Idling Hours", type number}})
				in
				    #"Changed Type2"

