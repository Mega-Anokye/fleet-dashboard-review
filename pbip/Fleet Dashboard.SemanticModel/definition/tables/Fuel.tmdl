	partition Fuel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fuel_sheet_actros_usd.csv"),[Delimiter=",", Columns=16, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"SN", Int64.Type}, {"Truck ID", type text}, {"Date", type date}, {"Pump Location", type text}, {"Fill / Lit", type number}, {"Start ODO", Int64.Type}, {"End ODO", Int64.Type}, {"Coupon #", type text}, {"Route", type text}, {"Route#", type text}, {"Veh Type", type text}, {"Deployment", type text}, {"Driver Name", type text}, {"Dist Covered", Int64.Type}, {"Km / Lit", type number}, {"Remarks", type text}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"Truck ID", Text.Trim, type text}, {"Pump Location", Text.Trim, type text}, {"Coupon #", Text.Trim, type text}, {"Route", Text.Trim, type text}, {"Route#", Text.Trim, type text}, {"Veh Type", Text.Trim, type text}, {"Deployment", Text.Trim, type text}, {"Driver Name", Text.Trim, type text}, {"Remarks", Text.Trim, type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"Truck ID", Text.Clean, type text}, {"Pump Location", Text.Clean, type text}, {"Coupon #", Text.Clean, type text}, {"Route", Text.Clean, type text}, {"Route#", Text.Clean, type text}, {"Veh Type", Text.Clean, type text}, {"Deployment", Text.Clean, type text}, {"Driver Name", Text.Clean, type text}, {"Remarks", Text.Clean, type text}}),
				    #"Added Custom1" = Table.AddColumn(#"Cleaned Text", "Fuel Cost USD", each Number.FromText(
				    Text.BetweenDelimiters(
				        [Remarks],
				        "Total fuel cost: $",
				        " USD"
				    ),
				    "en-US"
				)),
				    #"Added Custom" = Table.AddColumn(#"Added Custom1", "Pump Rate USD", each Number.FromText(
				    Text.BetweenDelimiters(
				        [Remarks],
				        "Pump rate: $",
				        "/L"
				    ),
				    "en-US"
				)),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Fuel Cost USD", type number}, {"Pump Rate USD", type number}}),
				    #"Added Custom2" = Table.AddColumn(#"Changed Type1", "ODO Difference", each [End ODO] - [Start ODO]),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Added Custom2",{{"ODO Difference", Int64.Type}}),
				    #"Added Custom3" = Table.AddColumn(#"Changed Type2", "ODO Validation", each if [ODO Difference] = [Dist Covered]
				then "Valid"
				else "Mismatch"),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Added Custom3",{{"ODO Validation", type text}})
				in
				    #"Changed Type3"

