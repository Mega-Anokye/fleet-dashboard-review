	partition Maintenance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "maintenance_log_actros_usd.csv"),[Delimiter=",", Columns=11, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"SN", Int64.Type}, {"Truck ID", type text}, {"Date", type date}, {"Maintenance Type", type text}, {"Priority", type text}, {"Description", type text}, {"Part Replaced", type text}, {"Mechanic Name", type text}, {"Downtime_Days", type number}, {"Cost_USD", type number}, {"Remarks", type text}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"Truck ID", Text.Trim, type text}, {"Maintenance Type", Text.Trim, type text}, {"Priority", Text.Trim, type text}, {"Description", Text.Trim, type text}, {"Part Replaced", Text.Trim, type text}, {"Mechanic Name", Text.Trim, type text}, {"Remarks", Text.Trim, type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"Truck ID", Text.Clean, type text}, {"Maintenance Type", Text.Clean, type text}, {"Priority", Text.Clean, type text}, {"Description", Text.Clean, type text}, {"Part Replaced", Text.Clean, type text}, {"Mechanic Name", Text.Clean, type text}, {"Remarks", Text.Clean, type text}}),
				    #"Changed Type with Locale" = Table.TransformColumnTypes(#"Cleaned Text", {{"Date", type date}}, "en-GB"),
				    #"Changed Type with Locale1" = Table.TransformColumnTypes(#"Changed Type with Locale", {{"Cost_USD", type number}}, "en-US"),
				    #"Added Custom" = Table.AddColumn(#"Changed Type with Locale1", "Maintenance Type Clean", each if Text.Upper(
				    Text.Trim([Maintenance Type])
				) = "PREVENTIVE"
				then "Preventive"
				else if Text.Upper(
				    Text.Trim([Maintenance Type])
				) = "CORRECTIVE"
				then "Corrective"
				else "Other"),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Priority Clean", each if Text.Upper(
				    Text.Trim([Priority])
				) = "LOW" then "Low"
				else if Text.Upper(
				    Text.Trim([Priority])
				) = "MEDIUM" then "Medium"
				else if Text.Upper(
				    Text.Trim([Priority])
				) = "HIGH" then "High"
				else if Text.Upper(
				    Text.Trim([Priority])
				) = "CRITICAL" then "Critical"
				else "Other"),
				    #"Trimmed Text1" = Table.TransformColumns(#"Added Custom1",{{"Part Replaced", Text.Trim, type text}}),
				    #"Cleaned Text1" = Table.TransformColumns(#"Trimmed Text1",{{"Part Replaced", Text.Clean, type text}}),
				    #"Added Custom2" = Table.AddColumn(#"Cleaned Text1", "Part Category", each if Text.Upper(
				    Text.Trim([Part Replaced])
				) = "N/A (SERVICE ONLY)"
				then "Service Only"
				else "Component Replacement"),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom2",{{"Maintenance Type Clean", type text}, {"Priority Clean", type text}, {"Part Category", type text}})
				in
				    #"Changed Type1"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

